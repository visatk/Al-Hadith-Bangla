<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Preserve user reader preferences and Room bookmarks/notes across reinstalls -->
    <include domain="file" path="datastore/al_hadith_reader_settings.preferences_pb" />
    <include domain="database" path="al_hadith_room_engine.db" />
    <!-- Exclude temporary SQLite staging cache -->
    <exclude domain="file" path="sqlite_inspection_cache" />
</full-backup-content>
